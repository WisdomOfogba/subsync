generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  name               String?
  telegramChatId     String?        
  walletBalance      Float          @default(0)
  paystackCustomerCode String?
  paystackDva        String?        // Dedicated Virtual Account Number
  paystackBankName   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  baseCurrency       String         @default("NGN")

  subscriptions      Subscription[]
  virtualCards       VirtualCard[]
  transactions       Transaction[]
}

model VirtualCard {
  id        String   @id @default(uuid())
  userId    String
  name      String
  cardNumber String  @unique
  expiry    String
  cvv       String
  balance   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  type        String   // "WALLET_FUND", "CARD_FUND", "MERCHANT_PAYMENT"
  description String
  status      String   @default("SUCCESS") // "SUCCESS", "FAILED"
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String
  name             String
  amount           Float
  currency         String    @default("NGN")
  category         String
  billingCycle     String    @default("MONTHLY")
  nextChargeDate   DateTime
  status           String    @default("ACTIVE")
  paymentMethod    String    @default("DIRECT_DEBIT") // "DIRECT_DEBIT", "VIRTUAL_CARD"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastInteractedAt DateTime? @default(now())
  user             User      @relation(fields: [userId], references: [id])
}
